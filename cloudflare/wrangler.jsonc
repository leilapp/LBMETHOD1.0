// LB METHOD en Cloudflare: un solo Worker sirve las pantallas (React compilado en ./public) y la API (/api).
// Así todo vive en el mismo dominio, como se aprobó desde la Fase 1 (cookie SameSite=Strict + token CSRF, sin CORS).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Mismo nombre que el Worker que creó tu conexión de Git en Cloudflare, para que publique sobre ese Worker.
  "name": "lbmethod1-0",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // El Worker atiende todo para poner las mismas cabeceras de seguridad en páginas, archivos y API.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lbmethod",
      // Base creada en tu cuenta el 31/10/2026 (región oeste de Norteamérica). El id no es un secreto.
      // En local (wrangler dev) se usa una copia en .wrangler/ y este valor no importa.
      "database_id": "54fa22c6-f532-45a0-9143-db0afa9f03e8",
      "migrations_dir": "migrations"
    }
  ],
  // Fotos, imágenes y videos privados en Workers KV: gratis y sin medio de pago (1 GB en total, 1 000 escrituras al día).
  // No tiene acceso público: los archivos solo salen por la API. El id no es un secreto.
  // Si algún día activas R2, agrega aquí "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "lbmethod-media" }]
  // y los archivos nuevos se guardarán en R2 (ver src/storage.ts).
  "kv_namespaces": [{ "binding": "FILES", "id": "4c7f921509eb43f28aae57cd5eaace19" }],
  "vars": {
    "SESSION_HOURS": "8",
    "MAX_FAILED_LOGINS": "5",
    "LOCKOUT_MINUTES": "15",
    "LOGIN_REQUESTS_PER_MINUTE": "10",
    // 5 MB por imagen. Videos: 25 MB, para no agotar el espacio gratuito de 1 GB ni el procesador del plan gratis.
    // Para videos largos conviene un enlace (YouTube no listado, por ejemplo).
    "MAX_IMAGE_BYTES": "5242880",
    "MAX_VIDEO_BYTES": "26214400",
    "MAX_PHOTO_BYTES": "10485760"
  },
  "observability": { "enabled": true },
  // Vistas previas de Cloudflare (ramas que no son la de producción). Sin base de datos ni archivos a propósito:
  // así una vista previa nunca toca los datos reales de las clientas. Solo comprueba que la app se arma y publica.
  "previews": {
    "vars": {
      "SESSION_HOURS": "8",
      "MAX_FAILED_LOGINS": "5",
      "LOCKOUT_MINUTES": "15",
      "LOGIN_REQUESTS_PER_MINUTE": "10",
      "MAX_IMAGE_BYTES": "5242880",
      "MAX_VIDEO_BYTES": "26214400",
      "MAX_PHOTO_BYTES": "10485760"
    }
  }
}
