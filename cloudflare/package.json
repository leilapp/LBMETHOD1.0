{
  "name": "lbmethod-cloudflare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LB METHOD sobre Cloudflare Workers + D1 (etapa 1: prueba de inicio de sesión y clientes)",
  "scripts": {
    "build": "node scripts/build-frontend.mjs",
    "dev": "wrangler dev",
    "deploy": "node scripts/build-frontend.mjs && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply lbmethod --local",
    "db:migrate:remote": "wrangler d1 migrations apply lbmethod --remote",
    "create-trainer": "node scripts/create-trainer.mjs",
    "test": "node --test --test-reporter=spec test/api.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0"
  }
}
