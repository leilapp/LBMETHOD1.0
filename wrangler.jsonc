// Copia de cloudflare/wrangler.jsonc para que la conexión de Git de Cloudflare publique la app completa aunque su
// «directorio raíz» sea la raíz del repositorio. Antes de publicar arma las pantallas y las copia a cloudflare/public.
// Si cambias algo aquí, cámbialo también en cloudflare/wrangler.jsonc y en frontend/wrangler.jsonc
// (test/configuraciones.test.mjs comprueba que coincidan).
{
  "$schema": "cloudflare/node_modules/wrangler/config-schema.json",
  "name": "lbmethod1-0",
  "main": "cloudflare/src/index.ts",
  "compatibility_date": "2026-10-01",
  "build": { "command": "cd cloudflare && npm ci && npm run build" },
  "assets": {
    "directory": "cloudflare/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lbmethod",
      "database_id": "54fa22c6-f532-45a0-9143-db0afa9f03e8",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "FILES", "id": "4c7f921509eb43f28aae57cd5eaace19" }],
  "vars": {
    "SESSION_HOURS": "8",
    "MAX_FAILED_LOGINS": "5",
    "LOCKOUT_MINUTES": "15",
    "LOGIN_REQUESTS_PER_MINUTE": "10",
    "MAX_IMAGE_BYTES": "5242880",
    "MAX_VIDEO_BYTES": "26214400",
    "MAX_PHOTO_BYTES": "10485760"
  },
  "observability": { "enabled": true },
  // Vistas previas de Cloudflare (ramas que no son la de producción). Sin base de datos ni archivos a propósito:
  // así una vista previa nunca toca los datos reales de las clientas. Solo comprueba que la app se arma y publica.
  "previews": {
    "vars": {
      "SESSION_HOURS": "8",
      "MAX_FAILED_LOGINS": "5",
      "LOCKOUT_MINUTES": "15",
      "LOGIN_REQUESTS_PER_MINUTE": "10",
      "MAX_IMAGE_BYTES": "5242880",
      "MAX_VIDEO_BYTES": "26214400",
      "MAX_PHOTO_BYTES": "10485760"
    }
  }
}
